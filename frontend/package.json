{
  "name": "rufree-frontend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start --port 8083",
    "start:clear": "expo start --clear --port 8083",
    "clear": "expo start --clear --port 8083",
    "tunnel": "expo start --tunnel --port 8083",
    "tunnel:clear": "expo start --clear --tunnel --port 8083",
    "android": "expo start --android --port 8083",
    "ios": "expo start --ios --port 8083",
    "web": "expo start --web --port 8083",
    "test": "jest",
    "test:ci": "jest --ci --runInBand",
    "doctor": "npx expo-doctor"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@firebase/app": "^0.14.13",
    "@firebase/auth": "^1.13.2",
    "@firebase/firestore": "^4.15.0",
    "@firebase/storage": "^0.14.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/geolocation": "^3.4.0",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "expo": "~54.0.35",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-location": "~19.0.8",
    "expo-status-bar": "~3.0.9",
    "firebase": "^12.14.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.0",
    "@testing-library/react-native": "^13.3.3",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "react-test-renderer": "^19.1.0"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "uuid": "^11.1.1"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.js"
    ],
    "moduleNameMapper": {
      "\\.(png|jpg|jpeg)$": "<rootDir>/test/fileMock.js"
    }
  }
}
